{
  "name": "docker-manager",
  "version": "1.0.0",
  "description": "Self-hosted web app and CLI to inspect and control Docker containers on your own Linux host.",
  "license": "MIT",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "docker-manager": "bin/docker-manager"
  },
  "scripts": {
    "start": "node src/server.js",
    "lint": "eslint .",
    "test": "node --test",
    "test:coverage": "c8 --check-coverage --lines 70 --include \"src/docker/**\" --include \"src/compose/**\" --reporter text node --test"
  },
  "dependencies": {
    "docker-modem": "5.0.7",
    "dockerode": "5.0.1",
    "ejs": "7.0.2",
    "express": "5.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "c8": "^10.1.2",
    "eslint": "^9.0.0",
    "globals": "^15.0.0"
  }
}

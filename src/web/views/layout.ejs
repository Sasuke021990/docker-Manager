<!doctype html>
<html lang="en" data-theme="<%= theme %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= (typeof title !== 'undefined' && title) ? title + ' · Docker Manager' : 'Docker Manager' %></title>
  <link rel="stylesheet" href="/assets/app.css">
  <meta name="csrf-token" content="<%= csrfToken %>">
  <meta name="stop-timeout" content="<%= settings.stopTimeoutSeconds %>">
  <script src="/assets/app.js" defer></script>
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="app-header" role="banner">
    <div class="app-header-inner">
      <a class="brand" href="/containers">
        <svg class="brand-glyph" aria-hidden="true"><use href="/assets/icons.svg#i-container"></use></svg>
        <span class="brand-name">Docker Manager</span>
      </a>
      <nav class="nav" aria-label="Primary">
        <a class="nav-link<%= currentPath.startsWith('/containers') ? ' is-active' : '' %>" href="/containers"<%= currentPath.startsWith('/containers') ? ' aria-current="page"' : '' %>>Containers</a>
        <a class="nav-link<%= currentPath.startsWith('/stacks') ? ' is-active' : '' %>" href="/stacks"<%= currentPath.startsWith('/stacks') ? ' aria-current="page"' : '' %>>Stacks</a>
        <a class="nav-link<%= currentPath.startsWith('/images') ? ' is-active' : '' %>" href="/images"<%= currentPath.startsWith('/images') ? ' aria-current="page"' : '' %>>Images</a>
        <a class="nav-link<%= currentPath.startsWith('/volumes') ? ' is-active' : '' %>" href="/volumes"<%= currentPath.startsWith('/volumes') ? ' aria-current="page"' : '' %>>Volumes</a>
        <a class="nav-link<%= currentPath.startsWith('/networks') ? ' is-active' : '' %>" href="/networks"<%= currentPath.startsWith('/networks') ? ' aria-current="page"' : '' %>>Networks</a>
        <a class="nav-link<%= currentPath.startsWith('/events') ? ' is-active' : '' %>" href="/events"<%= currentPath.startsWith('/events') ? ' aria-current="page"' : '' %>>Events</a>
      </nav>
      <div class="header-cluster">
        <%# C-03 host switcher: server renders the active host as a no-JS
            fallback; app.js enriches the popover with /api/hosts. %>
        <div class="host-switch" data-host-switch>
          <button class="host-chip host-chip--btn" type="button" data-host-trigger aria-haspopup="menu" aria-expanded="false" aria-label="Active host: <%= hostFrame.name %>. Switch host">
            <span class="dot <%= hostFrame.state === 'reachable' ? 'dot-run' : (hostFrame.state === 'too-old' ? 'dot-dead' : 'dot-stopped') %>"></span>
            <span class="host-name"><%= hostFrame.name %></span>
            <svg class="icon host-caret" aria-hidden="true"><use href="/assets/icons.svg#i-chevron-down"></use></svg>
          </button>
          <div class="host-pop" role="menu" data-host-pop hidden>
            <div class="host-pop-list" data-host-list>
              <div class="host-pop-row is-active" role="menuitemradio" aria-checked="true">
                <span class="dot <%= hostFrame.state === 'reachable' ? 'dot-run' : (hostFrame.state === 'too-old' ? 'dot-dead' : 'dot-stopped') %>"></span>
                <span class="host-pop-name"><%= hostFrame.name %></span>
                <span class="host-pop-meta"><%= hostFrame.apiVersion ? 'API ' + hostFrame.apiVersion : hostFrame.state %></span>
              </div>
            </div>
            <a class="host-pop-foot" href="/settings">Edit hosts in config.json</a>
          </div>
        </div>
        <% if (hostFrame.apiVersion) { %><span class="api-chip">API <%= hostFrame.apiVersion %></span><% } %>
        <span class="conn-pill conn-<%= hostFrame.state === 'reachable' ? 'live' : 'offline' %>" id="conn-pill">
          <span class="conn-dot" aria-hidden="true"></span>
          <span class="conn-text" aria-live="polite"><%= hostFrame.state === 'reachable' ? 'Live' : 'Offline' %></span>
        </span>
        <a class="icon-btn event-bell" href="/events" data-event-bell aria-label="Events, no unread">
          <svg class="icon" aria-hidden="true"><use href="/assets/icons.svg#i-bell"></use></svg>
          <span class="event-badge" data-event-badge hidden>0</span>
        </a>
        <button class="icon-btn" id="theme-toggle" type="button" aria-pressed="<%= theme === 'dark' ? 'true' : 'false' %>" aria-label="Switch to dark theme">
          <svg class="icon" aria-hidden="true"><use href="/assets/icons.svg#i-<%= theme === 'dark' ? 'sun' : 'moon' %>"></use></svg>
        </button>
        <button class="icon-btn" type="button" data-activity-open aria-label="Activity, last 100 actions">
          <svg class="icon" aria-hidden="true"><use href="/assets/icons.svg#i-activity"></use></svg>
        </button>
        <a class="icon-btn<%= currentPath.startsWith('/settings') ? ' is-active' : '' %>" href="/settings" aria-label="Settings">
          <svg class="icon" aria-hidden="true"><use href="/assets/icons.svg#i-settings"></use></svg>
        </a>
      </div>
    </div>
  </header>
  <main id="main" class="page">
    <%- body %>
  </main>
  <footer class="app-foot">Docker Manager <%= appVersion %> · <%= hostFrame.apiVersion ? 'API ' + hostFrame.apiVersion + ' · ' : '' %>private network, no authentication</footer>
  <div class="toast-stack" id="toasts"></div>

  <%# Shared row menu (C-13): one element, repositioned per trigger by app.js.
      Items are enabled/hidden per container state and self-guard. %>
  <div class="row-menu" role="menu" aria-label="Container actions" hidden data-row-menu>
    <a class="row-menu-item" role="menuitem" href="#" data-menu-details>Open details</a>
    <a class="row-menu-item" role="menuitem" href="#" data-menu-logs>View logs</a>
    <button class="row-menu-item" role="menuitem" type="button" data-act="start">Start</button>
    <button class="row-menu-item" role="menuitem" type="button" data-act="restart">Restart</button>
    <button class="row-menu-item" role="menuitem" type="button" data-act="pause">Pause</button>
    <button class="row-menu-item" role="menuitem" type="button" data-act="unpause">Unpause</button>
    <div class="row-menu-divider" role="separator"></div>
    <button class="row-menu-item row-menu-item--danger" role="menuitem" type="button" data-act="stop" data-confirm="stop">Stop…</button>
    <button class="row-menu-item row-menu-item--danger" role="menuitem" type="button" data-act="kill" data-confirm="kill">Kill…</button>
    <button class="row-menu-item row-menu-item--danger" role="menuitem" type="button" data-act="rm" data-confirm="rm">Remove…</button>
    <button class="row-menu-item row-menu-cancel" type="button" data-menu-cancel>Cancel</button>
  </div>

  <%# Destructive-action dialog (FR-026, design §7.6): copy filled per verb
      by app.js. Cancel is focused on open; the request sends only on the
      confirm button. %>
  <div class="modal-backdrop" hidden data-confirm-backdrop>
    <div class="modal" role="dialog" aria-modal="true" aria-labelledby="confirm-title" aria-describedby="confirm-body" data-confirm-dialog>
      <h2 class="modal-title" id="confirm-title"></h2>
      <div class="modal-body" id="confirm-body">
        <p data-confirm-consequence></p>
        <p class="modal-kept" data-confirm-kept></p>
        <div class="choice-group" data-confirm-choice hidden>
          <label class="choice"><input type="radio" name="rm-mode" value="stop" checked> <span>Stop first, then remove</span></label>
          <label class="choice"><input type="radio" name="rm-mode" value="force"> <span>Force remove</span></label>
        </div>
        <div class="error-block" data-confirm-error hidden>
          <strong data-confirm-error-action></strong>
          <p class="mono" data-confirm-error-message></p>
        </div>
      </div>
      <div class="modal-foot">
        <button class="btn" type="button" data-confirm-cancel>Cancel</button>
        <button class="btn btn-danger" type="button" data-confirm-ok><span data-confirm-ok-label></span></button>
      </div>
    </div>
  </div>

  <%# Activity drawer (C-07, FR-031): session-only action ring, never history. %>
  <aside class="drawer-shell" hidden data-activity>
    <div class="drawer-scrim" data-activity-close></div>
    <div class="drawer-panel drawer-panel--activity" role="complementary" aria-labelledby="activity-title">
      <header class="drawer-head">
        <div class="drawer-head-text"><h2 id="activity-title">Activity · last 100 actions</h2></div>
        <div class="drawer-head-right">
          <button class="text-btn" type="button" data-activity-clear>Clear view</button>
          <button class="icon-btn" type="button" data-activity-close aria-label="Close activity">
            <svg class="icon" aria-hidden="true"><use href="/assets/icons.svg#i-close"></use></svg>
          </button>
        </div>
      </header>
      <div class="drawer-body" data-activity-list>
        <p class="empty-hint">No actions yet in this session. Start, stop or remove a container and it will appear here.</p>
      </div>
      <footer class="drawer-foot">Cleared when Docker Manager restarts</footer>
    </div>
  </aside>
</body>
</html>
